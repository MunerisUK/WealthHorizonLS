# Copy this file to .env and fill it in. Keep .env private: it holds your
# passwords. Never commit it or post it anywhere.

# The database password. Any long random string. For example:
#   openssl rand -hex 24
PGPASSWORD=

# Signs your sign-in sessions. Generate it with:
#   openssl rand -hex 32
JWT_SECRET=

# Optional. Seals a Trading 212 API key before it is stored. Generate it with:
#   openssl rand -hex 32
# Leave it empty if you will not connect Trading 212. If you change it later,
# you will need to enter your Trading 212 key again.
WH_CREDENTIAL_KEY=

# Optional. The port the web app is served on. The default is 8082.
# WH_PORT=8082

# Optional. Run a particular build instead of the latest, for example B1070.
# The build numbers are listed on the packages page of this repository.
# WH_TAG=latest
